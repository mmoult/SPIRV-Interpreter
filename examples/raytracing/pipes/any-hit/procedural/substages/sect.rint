#version 460
#extension GL_EXT_ray_tracing : enable

hitAttributeEXT vec2 attribs;

void main()
{
    attribs = vec2(0.25, 0.5);

    // The hit is reported at t = 2, wherever the ray first meets the bounds of the geometry.
    reportIntersectionEXT(2.0, 0u);
}
