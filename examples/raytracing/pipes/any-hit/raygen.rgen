#version 460
#extension GL_EXT_ray_tracing : enable

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0) uniform RayProperties
{
    vec3 origin;
    vec3 direction;
} ray;

struct HitInfo
{
    vec3 weights;    // Barycentric weights of the closest hit
    float distance;  // Distance of the latest accepted hit
    uint hits;       // Number of hits accepted
    uint primitive;  // Primitive of the closest hit
};
layout(location = 0) rayPayloadEXT HitInfo payload;

void main()
{
    payload.weights = vec3(0.0);
    payload.distance = -1.0;
    payload.hits = 0u;
    payload.primitive = 0xFFFFFFFFu;  // None

    // No opaque flag is given, so any hit shaders may run for every triangle.
    traceRayEXT(topLevelAS, gl_RayFlagsNoOpaqueEXT, 0xff, 0, 0, 0, ray.origin, 0.001, ray.direction, 5.0, 0);
}
